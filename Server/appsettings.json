{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // -------------------------------------------------------------------------
  // ⚠️  NO PONGAS CREDENCIALES REALES EN ESTE ARCHIVO.
  //
  //  Este archivo se sube a Git. Para los secretos usa cualquiera de estas
  //  opciones (cualquiera sobreescribe los valores de aquí):
  //
  //  1) appsettings.Development.json  ← ya está en .gitignore
  //  2) Variables de entorno         ej: Smtp__Pass=xxxxx  (doble guion bajo)
  //  3) User Secrets (recomendado en local):
  //        cd Server
  //        dotnet user-secrets set "Smtp:Pass" "tu-app-password"
  //        dotnet user-secrets set "Jwt:Key"  "una-clave-aleatoria-larga"
  // -------------------------------------------------------------------------

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "EnableSsl": "true",
    "User": "",
    "Pass": "",
    "ToEmail": ""
  },

  "Jwt": {
    "Key": "",
    "Issuer": "canacoleon.com",
    "Audience": "canacoleon.com"
  },

  // Lista de dominios autorizados a llamar al API desde el navegador (CORS).
  // En producción déjalo SOLO con tu dominio real.
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  }
}
